{
  "manifest_version": 3,
  "name": "APTO - RSPE do SEEU, Triagem da Mesa, Ficha do SIAPEN, processos e atendimentos do SAP",
  "short_name": "APTO RSPE",
  "version": "1.12.0",
  "description": "RSPE do SEEU e ficha do SIAPEN para a pasta do APTO, triagem da Mesa do Defensor (só leitura), nº do processo no SAP e a fila de atendimentos do SAP para o APTO (só leitura) e a leitura do SEI para o APTO (só leitura, endereço do SEI autorizado por você).",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://seeu.pje.jus.br/*",
    "https://seeu-transfer.s3.sa-east-1.amazonaws.com/*",
    "https://seeu-transfer.s3.amazonaws.com/*",
    "https://app.siapen.ms.gov.br/*",
    "https://*.defensoria.ms.def.br/*",
    "http://127.0.0.1:47321/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "comum.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://seeu.pje.jus.br/seeu/*"
      ],
      "js": [
        "comum.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.siapen.ms.gov.br/*"
      ],
      "js": [
        "comum.js",
        "siapen.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.siapen.ms.gov.br/*"
      ],
      "js": [
        "siapen_pagina.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.defensoria.ms.def.br/sap/*"
      ],
      "js": [
        "comum.js",
        "sap.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.defensoria.ms.def.br/sap/*"
      ],
      "js": [
        "atd_comum.js",
        "atd_sap.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sei.defensoria.ms.def.br/sei/*"
      ],
      "js": [
        "sei_aba.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://seeu.pje.jus.br/seeu/*"
      ],
      "js": [
        "seeu_aba.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "APTO - SEEU, Triagem, SIAPEN, SAP e Atendimentos",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png",
      "48": "icones/48.png"
    }
  },
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://seeu.pje.jus.br https://seeu-transfer.s3.sa-east-1.amazonaws.com https://seeu-transfer.s3.amazonaws.com http://127.0.0.1:* https:"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "apto@apto.local",
      "strict_min_version": "128.0"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sei/lib/*.js"
      ],
      "matches": [
        "https://sei.defensoria.ms.def.br/*"
      ]
    }
  ]
}
