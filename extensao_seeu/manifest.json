{
  "manifest_version": 3,
  "name": "APTO - RSPE do SEEU, Ficha do SIAPEN e processos do SAP",
  "short_name": "APTO RSPE",
  "version": "1.6.0",
  "description": "Salva o RSPE do SEEU e a Ficha Disciplinar do SIAPEN na pasta da base do APTO, e acha no SAP da Defensoria o nº do processo do último atendimento do NUSPEN.",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://seeu.pje.jus.br/*",
    "https://app.siapen.ms.gov.br/*",
    "https://*.defensoria.ms.def.br/*",
    "http://127.0.0.1:47321/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://seeu.pje.jus.br/seeu/*"
      ],
      "js": [
        "comum.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.siapen.ms.gov.br/*"
      ],
      "js": [
        "comum.js",
        "siapen.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.siapen.ms.gov.br/*"
      ],
      "js": [
        "siapen_pagina.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.defensoria.ms.def.br/sap/*"
      ],
      "js": [
        "comum.js",
        "sap.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "APTO - SEEU, SIAPEN e SAP",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png",
      "48": "icones/48.png"
    }
  },
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:47321"
  }
}
